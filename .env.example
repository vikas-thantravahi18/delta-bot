# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real .env file.

# Delta Exchange API credentials (create read+trade keys in the Delta web app).
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Base URL:
#   Global : https://api.delta.exchange
#   India  : https://api.india.delta.exchange
DELTA_BASE_URL=https://api.india.delta.exchange

# Telegram trade notifications (optional; coded as "anime releases").
# 1) @BotFather -> /newbot -> copy the token below.
# 2) message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
# 3) set notify.enabled: true in the strategy's config .yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
